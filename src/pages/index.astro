---
import Base from '../layouts/Base.astro';
import HeroField from '../components/HeroField.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';

const entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  email: `mailto:${site.email}`,
  jobTitle: site.role,
  address: { '@type': 'PostalAddress', addressLocality: site.location, addressCountry: 'VN' },
};
---

<Base
  title={`${site.name} — engineering and quantitative research`}
  description="Project writeups from Ho Chi Minh City: a cointegration screen that found nothing, post-earnings drift in VN100 mid-caps, a test-extraction pipeline, and QA on a live platform."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="shell">
      <p class="eyebrow">{site.location}</p>
      {/* The thesis. It appears exactly once on this site — PRD §7.1. Do not
          repeat it in a title, a heading, the footer or a meta description. */}
      <h1 class="thesis">
        Most of what I build is an answer to the same question: how does the
        under-resourced thing beat the better-resourced one?
      </h1>
    </div>
  </section>

  <HeroField />

  <section class="shell bio-band">
    <p class="bio measure">
      I work across web development, security and LLM pipelines, and separately
      build English-teaching material for Vietnamese students. I am not
      credentialed in any of it — I run my own curriculum and grade myself
      honestly.
    </p>
  </section>

  <section class="shell work" id="work" aria-labelledby="work-heading">
    <h2 class="section-heading" id="work-heading">Four writeups</h2>
    <p class="section-note measure muted">
      Each one is the same four sections: what the constraint was, what I
      decided, what I rejected, and what came out. The numbers are the numbers.
    </p>

    <ol class="index" role="list">
      {entries.map((entry, i) => (
        <li class="index__item">
          <span class="index__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="index__body">
            <h3 class="index__title">
              <a href={`/work/${entry.id}/`}>{entry.data.title}</a>
            </h3>
            <p class="index__result">{entry.data.result}</p>
            <p class="index__meta">
              <span>{entry.data.subject}</span>
              <span aria-hidden="true">·</span>
              <time datetime={entry.data.date.toISOString().slice(0, 10)}>
                {entry.data.dateLabel}
              </time>
            </p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="shell contact-line">
    <p class="measure">
      Email is the way in: <a href={`mailto:${site.email}`}>{site.email}</a>.
      More detail on <a href="/about/">about</a> and <a href="/contact/">contact</a>.
    </p>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--s-6) var(--s-5);
  }
  @media (min-width: 48em) {
    .hero { padding-block: var(--s-7) var(--s-6); }
  }

  .thesis {
    font-size: var(--step-4);
    font-weight: 400;
    font-style: italic;
    line-height: 1.16;
    letter-spacing: -0.018em;
    max-width: 22ch;
  }
  @media (min-width: 48em) {
    .thesis { max-width: 26ch; }
  }

  .bio-band {
    padding-top: var(--s-5);
  }
  .bio {
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .work { padding-top: var(--s-8); }

  .section-heading {
    font-size: var(--step--1);
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: var(--s-2);
    border-bottom: 2px solid var(--accent);
  }
  .section-note {
    margin-top: var(--s-3);
    font-size: var(--step-0);
  }

  .index {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
  }

  .index__item {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-2);
    padding-block: var(--s-5);
    border-top: 1px solid var(--border);
  }
  .index__item:first-child { border-top: 0; padding-top: 0; }

  @media (min-width: 48em) {
    .index__item {
      grid-template-columns: 5rem minmax(0, 1fr);
      gap: 0 var(--s-4);
      padding-block: var(--s-6);
    }
  }

  .index__num {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-variant-numeric: tabular-nums;
    color: var(--accent);
    line-height: 1.1;
  }

  .index__body { max-width: var(--measure); }

  .index__title {
    font-size: var(--step-3);
    letter-spacing: -0.02em;
    margin-bottom: var(--s-2);
  }
  .index__title a {
    color: var(--text);
    text-decoration-color: transparent;
  }
  .index__title a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  /* The result line is the hook. It gets the second-largest type on the page. */
  .index__result {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.45;
    margin-bottom: var(--s-2);
  }

  .index__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-2);
    font-size: var(--step--1);
    color: var(--muted);
    letter-spacing: 0.02em;
    margin: 0;
  }

  .contact-line {
    padding-top: var(--s-7);
    font-size: var(--step-1);
  }
</style>
