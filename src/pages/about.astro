---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { Content, frontmatter } from '../content/about.md';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  email: `mailto:${site.email}`,
  jobTitle: site.role,
  address: { '@type': 'PostalAddress', addressLocality: site.location, addressCountry: 'VN' },
};
---

<Base
  title={`About — ${site.name}`}
  description="Web development, security and LLM pipelines, and English teaching, from Ho Chi Minh City."
  jsonLd={jsonLd}
>
  <article class="shell page">
    <h1>{frontmatter.heading}</h1>

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .page { padding-block: var(--s-6) var(--s-7); }
  .page h1 {
    font-size: var(--step-3);
    line-height: 1.15;
    margin-bottom: var(--s-4);
  }
</style>
