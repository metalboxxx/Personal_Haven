---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import mail from '@tabler/icons/outline/mail.svg?raw';
import linkedin from '@tabler/icons/outline/brand-linkedin.svg?raw';
import facebook from '@tabler/icons/outline/brand-facebook.svg?raw';
import github from '@tabler/icons/outline/brand-github.svg?raw';

// Outline icons, inlined at build time. They draw in currentColor, so they
// follow the theme tokens: change the palette and the icons change with it.
const icons: Record<string, string> = { email: mail, linkedin, facebook, github };
const icon = (label: string) =>
  (icons[label.toLowerCase()] ?? '')
    .replace(/<svg[^>]*>/, '<svg class="contact__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">');

// Email first, then site.links. Each row shows the address without its
// protocol, so the reader sees where the link goes.
const rows = [
  { label: 'Email', href: `mailto:${site.email}`, text: site.email },
  ...site.links.map((l) => ({
    label: l.label,
    href: l.href,
    text: l.href.replace(/^https?:\/\/(www\.)?/, ''),
  })),
];
---

<Base
  title={`Contact — ${site.name}`}
  description={`Email ${site.email}. ${site.location}, UTC+7.`}
>
  <article class="shell contact">
    <h1>Contact</h1>
    <p class="contact__where">{site.location}, UTC+7</p>

    <dl class="contact__list">
      {rows.map((r) => (
        <div class="contact__row">
          <dt><Fragment set:html={icon(r.label)} />{r.label}</dt>
          <dd><a href={r.href}>{r.text}</a></dd>
        </div>
      ))}
    </dl>
  </article>
</Base>

<style>
  .contact { padding-block: var(--s-6) var(--s-7); }

  .contact h1 {
    font-size: var(--step-3);
    line-height: 1.15;
  }

  .contact__where {
    margin-top: var(--s-1);
    color: var(--muted);
  }

  .contact__list {
    max-width: var(--measure);
    margin: var(--s-5) 0 0;
  }

  /* Label on the left, address on the right; stacked on narrow screens. */
  .contact__row {
    display: grid;
    grid-template-columns: 1fr;
    padding-block: var(--s-2);
    border-top: 1px solid var(--border);
  }
  .contact__row:last-child { border-bottom: 1px solid var(--border); }
  @media (min-width: 36em) {
    .contact__row { grid-template-columns: 7rem minmax(0, 1fr); gap: var(--s-3); }
  }

  .contact__row dt {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    color: var(--muted);
  }
  .contact__row :global(.contact__icon) {
    width: 1.15em;
    height: 1.15em;
    flex: none;
    color: var(--accent);
  }
  .contact__row dd { margin: 0; overflow-wrap: anywhere; }
</style>
