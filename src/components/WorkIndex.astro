---
// The list of writeups, dated like journal entries: the date hangs in the
// left margin and the title, result and subject run beside it. Used on home
// for the top-level projects and on a project page for the studies inside it —
// same treatment in both places so a study reads as the same kind of thing as
// a writeup, one level down.
import { dateLabel } from '../lib/date';

interface Item {
  href: string;
  title: string;
  result: string;
  subject?: string;
  date: Date;
  dateLabel?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<ol class="index" role="list">
  {items.map((item) => (
    <li class="index__item">
      <time class="index__date" datetime={item.date.toISOString().slice(0, 10)}>{dateLabel(item)}</time>
      <div class="index__body">
        <h3 class="index__title">
          <a href={item.href}>{item.title}</a>
        </h3>
        <p class="index__result">{item.result}</p>
        {item.subject && <p class="index__meta">{item.subject}</p>}
      </div>
    </li>
  ))}
</ol>

<style>
  .index {
    list-style: none;
    margin: var(--s-5) 0 0;
    padding: 0;
  }

  .index__item {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-1);
    padding-block: var(--s-5);
    border-top: 1px solid var(--border);
  }
  /* The section heading above already draws a rule. */
  .index__item:first-child { border-top: 0; padding-top: 0; }

  @media (min-width: 48em) {
    .index__item {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: 0 var(--s-4);
    }
  }

  /* Set on the title's first line, so the date reads as the entry's margin
     note rather than a heading of its own. */
  .index__date {
    font-weight: 600;
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    line-height: 1.4;
  }
  @media (min-width: 48em) {
    .index__date { padding-top: 0.55em; }
  }

  .index__body { max-width: var(--measure); }

  .index__title {
    font-size: var(--step-3);
    letter-spacing: -0.01em;
    margin-bottom: var(--s-2);
  }
  .index__title a {
    color: var(--text);
    text-decoration-color: transparent;
  }
  .index__title a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  /* The result line is the hook: the title's weight drops away and the
     number is left to speak in plain text at a reading size. */
  .index__result {
    font-size: var(--step-1);
    line-height: 1.45;
    margin-bottom: var(--s-2);
  }

  .index__meta {
    font-size: var(--step--1);
    color: var(--muted);
    margin: 0;
  }
</style>
