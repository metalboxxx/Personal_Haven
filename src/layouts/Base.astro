---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/vietnamese-400.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/vietnamese-600.css';
import '@fontsource/newsreader/latin-600.css';
import '@fontsource/newsreader/vietnamese-600.css';
import '@fontsource/newsreader/latin-400-italic.css';
import '@fontsource/newsreader/vietnamese-400-italic.css';
import '../styles/global.css';
import { site, nav } from '../data/site';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  wide?: boolean;
}

const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.pages.dev');
// Astro serves /about/ but nav hrefs are written /about — compare without the
// trailing slash so aria-current actually matches.
const trim = (p: string) => (p.length > 1 ? p.replace(/\/+$/, '') : p);
const current = trim(Astro.url.pathname);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#FBF9F6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141210" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell">
        <a class="wordmark" href="/">{site.name}</a>
        <nav class="site-nav" aria-label="Primary">
          <ul>
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={current === trim(item.href) ? 'page' : undefined}
                >{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <span>{site.name} — {site.location}</span>
        <span><a href={`mailto:${site.email}`}>{site.email}</a></span>
      </div>
    </footer>
  </body>
</html>
