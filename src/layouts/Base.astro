---
import '@fontsource/bree-serif/latin-400.css';
import '@fontsource/bree-serif/latin-ext-400.css';
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/literata/opsz-italic.css';
import '../styles/global.css';
import { site, nav } from '../data/site';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  wide?: boolean;
}

const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.pages.dev');
// Astro serves /about/ but nav hrefs are written /about — compare without the
// trailing slash so aria-current actually matches.
const trim = (p: string) => (p.length > 1 ? p.replace(/\/+$/, '') : p);
const current = trim(Astro.url.pathname);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#F7F4FA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17153B" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {/* The one piece of client JS on the site, and the reason: a theme choice
        has to survive navigation, and only localStorage can carry it. Runs
        before paint so a pinned theme never flashes. It always resolves a
        theme (saved, else system) onto data-theme so the switch has one state
        to draw. With JS off nothing here runs, the system preference applies
        through the media query, and the switch is hidden. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
        <div>
          <a class="wordmark" href="/">{site.name}</a>
          <p class="site-place">{site.location}</p>
        </div>
        <nav class="site-nav" aria-label="Primary">
          <ul>
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={current === trim(item.href) ? 'page' : undefined}
                >{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        {/* A switch, not a button: sun on the left, moon on the right, a knob
            that slides to whichever is active. Click a side to pick it;
            keyboard activation toggles. */}
        <button class="theme-switch" type="button" role="switch" aria-checked="false" aria-label="Dark theme">
          <svg class="theme-switch__icon theme-switch__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
          <svg class="theme-switch__icon theme-switch__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
          </svg>
          <span class="theme-switch__knob" aria-hidden="true"></span>
        </button>
    </header>

    {/* One grid cell beside the rail, so the footer stays under the page. */}
    <div class="page-column">
      <main id="main">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="shell">
          <span>{site.name}, {site.location}</span>
          <span><a href={`mailto:${site.email}`}>{site.email}</a></span>
        </div>
      </footer>
    </div>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var sw = document.querySelector('.theme-switch');
        var fadeTimer;
        function sync() {
          sw.setAttribute('aria-checked', root.dataset.theme === 'dark' ? 'true' : 'false');
        }
        function set(theme) {
          if (root.dataset.theme === theme) return;
          // The crossfade: every colour transitions for 1s while this class is on.
          root.classList.add('theme-fading');
          clearTimeout(fadeTimer);
          fadeTimer = setTimeout(function () { root.classList.remove('theme-fading'); }, 1100);
          root.dataset.theme = theme;
          try { localStorage.setItem('theme', theme); } catch (e) {}
          sync();
        }
        sw.addEventListener('click', function (e) {
          var current = root.dataset.theme;
          // Mouse or touch: the side you clicked is the side you get.
          // Keyboard (detail === 0): toggle.
          if (e.detail > 0) {
            var box = sw.getBoundingClientRect();
            set(e.clientX - box.left < box.width / 2 ? 'light' : 'dark');
          } else {
            set(current === 'dark' ? 'light' : 'dark');
          }
        });
        sync();
      })();
    </script>
  </body>
</html>
